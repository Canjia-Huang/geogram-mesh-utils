@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Geolio's public headers depend on Geogram. FindGeogram.cmake is installed
# alongside this config file so downstream can resolve the dependency.
list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(Geogram)
list(REMOVE_AT CMAKE_MODULE_PATH 0)

include("${CMAKE_CURRENT_LIST_DIR}/GeolioTargets.cmake")

check_required_components(Geolio)
